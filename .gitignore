# 実データは一切コミットしない（private HF Dataset から実行時に取得する）。
# demo_data/ だけは例外: 著作物を含まない完全自作のデモ教材（コミット対象）
data/
*.jsonl
!demo_data/**/*.jsonl
# デモ実行時に生成されるもの（インデックス・採点履歴）はコミットしない
demo_data/chroma/
demo_data/ui/

# 秘密情報（Space では Secrets 環境変数を使う。ファイルは置かない）
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS
desktop.ini
Thumbs.db
